# Copy to .env and fill in. Never commit the real .env.

# --- Auth (demo) ---
PIN=1234

# --- Google Sheets ---
SHEETID=your-spreadsheet-id
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Web Push / PWA ---
# Generate once with: npx web-push generate-vapid-keys
# Changing these invalidates every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address browsers show on push permission prompts.
VAPID_SUBJECT=mailto:you@example.com

# Where push subscriptions + the reminder log are stored.
#   json  = local filesystem. Fine for dev / long-running Node host.
#   sheet = Google Sheet. REQUIRED on Vercel, where the filesystem is read-only.
PUSH_STORE=json

# Decides what "today" means for the once-per-day reminder.
NOTIFICATION_TIMEZONE=Asia/Jakarta

# Vercel Cron sends this as `Authorization: Bearer <secret>`.
# The cron route refuses to run if it is unset.
CRON_SECRET=
